# Kiwi Configuration
# All settings can be overridden via environment variables prefixed with KIWI_

# Application Name
KIWI_APP_NAME=Kiwi

# Upload limits
KIWI_MAX_UPLOAD_MB=512
KIWI_MAX_REQUEST_MB=1024
KIWI_MAX_FILE_COUNT=100

# Archive safety limits
KIWI_MAX_ARCHIVE_ENTRIES=10000
KIWI_MAX_ARCHIVE_UNCOMPRESSED_MB=2048

# Queue and Worker Concurrency
KIWI_MAX_QUEUE_SIZE=100
KIWI_MAX_QUEUE_WAIT_SECONDS=300
KIWI_MAX_JOB_DURATION_SECONDS=600
KIWI_WORKER_COUNT=2

# Temporary data retention (hard TTL from job completion in seconds)
KIWI_JOB_TTL_SECONDS=300
KIWI_CLEANUP_INTERVAL_SECONDS=15

# Strict local CORS origins (JSON array or comma-separated list)
KIWI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Binary paths (optional overrides if not in standard PATH or standard directories)
KIWI_SOFFICE_BIN=soffice
KIWI_TESSERACT_BIN=tesseract
KIWI_GHOSTSCRIPT_BIN=gswin64c
KIWI_FFMPEG_BIN=ffmpeg
KIWI_PANDOC_BIN=pandoc

